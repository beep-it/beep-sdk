{
  "name": "@beep-it/ai-gateway",
  "version": "0.1.0",
  "description": "Open-source AI inference gateway with a402 payment settlement on Sui",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "beep-ai": "./dist/bin/beep-ai.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly && tsup",
    "dev": "tsx watch src/bin/beep-ai.ts start",
    "start": "node dist/bin/beep-ai.js start",
    "lint": "eslint . --ext .ts",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "beep",
    "ai-gateway",
    "a402",
    "llm",
    "inference",
    "sui",
    "usdc",
    "openai-compatible"
  ],
  "author": "BEEP Engineering",
  "license": "MIT",
  "dependencies": {
    "@beep/sdk-core": "workspace:*",
    "axios": "^1.7.2",
    "commander": "^11.0.0",
    "express": "^4.18.2",
    "tiktoken": "^1.0.18",
    "uuid": "^9.0.0"
  },
  "peerDependencies": {
    "@mysten/seal": ">=0.1.0",
    "@mysten/sui": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@mysten/seal": {
      "optional": true
    },
    "@mysten/sui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.10",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "tsup": "^8.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.5.3"
  }
}
