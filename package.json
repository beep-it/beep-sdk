{
  "name": "beep-sdk-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @beep-it/sdk-core build && pnpm --filter \"./packages/*\" build",
    "test": "pnpm --filter \"./packages/*\" test",
    "build:cli": "pnpm --filter @beep-it/sdk-core build && pnpm --filter @beep-it/sdk-core run pack && pnpm --filter @beep-it/cli build",
    "release": "node scripts/prepare-release.js",
    "lint": "pnpm --filter \"./packages/*\" run lint",
    "dev": "pnpm --filter \"./packages/*\" run dev --parallel",
    "format": "prettier --write \"packages/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^8.49.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "pnpm": "10.34.5",
    "prettier": "^3.8.0",
    "typescript": "^5.5.3"
  },
  "pnpm": {
    "overrides": {
      "valibot": "1.4.2",
      "axios": "1.19.0",
      "esbuild": "0.25.0",
      "js-yaml": "4.3.2",
      "body-parser": "2.3.0",
      "qs@<6.15.2": ">=6.15.2",
      "form-data@<4.0.6": ">=4.0.6",
      "path-to-regexp@>=8.0.0 <8.4.0": ">=8.4.0",
      "browserslist@^4.0.0": "4.28.9",
      "brace-expansion@^1.0.0": "1.1.18",
      "brace-expansion@^2.0.0": "2.1.4",
      "flatted@^3.0.0": "3.4.4",
      "handlebars@^4.0.0": "4.7.9",
      "lodash@^4.0.0": "4.18.1",
      "lodash-es@^4.0.0": "4.18.1",
      "minimatch@^3.0.0": "3.1.5",
      "minimatch@^9.0.0": "9.0.9",
      "minimatch@^10.0.0": "10.2.6",
      "picomatch@^2.0.0": "2.3.2",
      "picomatch@^4.0.0": "4.0.7",
      "rollup@^4.0.0": "4.62.5",
      "sharp@<0.35.4": "0.35.4",
      "ws@^7.0.0": "7.5.13",
      "ws@^8.0.0": "8.21.3"
    }
  },
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "pnpm@10.34.5"
}
